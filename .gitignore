# dependencies
/node_modules
/packages/*/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/build

# generated project icons (copied during rescan)
/project-icons

# auto-generated documentation
/portio-docs.md

# misc
.DS_Store
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# project cache files (contain machine-specific paths)
projects-cache.json
packages/alfred-portio/.project-cache.json

# Firebase config (contains project-specific keys)
src/services/firebaseConfig.js
packages/PortIO-Swift/PortIO/Resources/GoogleService-Info.plist

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Swift / Xcode build artifacts
packages/PortIO-Swift/.build/
packages/PortIO-Swift/PortIO.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved
packages/PortIO-Swift/PortIO.xcodeproj/xcuserdata/
